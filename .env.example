# ====================================================
# SECURE ENVIRONMENT VARIABLES (EXAMPLE)
# ====================================================
# Do NOT commit actual secrets to source control.
# Use Secret Manager when deploying to Cloud Run.

# --- Core Platform ---
NODE_ENV="development" # development | production
PORT=3000
APP_URL="http://localhost:3000"

# --- Gemini API ---
# Set via Google Secret Manager in production.
GEMINI_API_KEY="test_gemini_api_key"

# --- Firebase Security / Database (Optional/Future) ---
FIREBASE_PROJECT_ID="test-project-id"
FIREBASE_CLIENT_EMAIL="firebase-admin@test-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY="test_api_key"
FIREBASE_AUTH_DOMAIN="test-project-id.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="test-project-id.appspot.com"
FIREBASE_APP_ID="1:123456789:web:abcdef123456"

# --- Vector / Cache ---
DATABASE_URL="postgres://user:pass@localhost:5432/lexguard"
REDIS_URL="redis://localhost:6379"
QDRANT_URL="http://localhost:6333"
