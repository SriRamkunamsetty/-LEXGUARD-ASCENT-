# ====================================================
# SECURE ENVIRONMENT VARIABLES (EXAMPLE)
# ====================================================
# Do NOT commit actual secrets to source control.
# Use Secret Manager when deploying to Cloud Run.

# --- Core Platform ---
NODE_ENV="development" # development | production
PORT=3000
APP_URL="http://localhost:3000"

# --- Gemini API ---
# Local development can use a Gemini Developer API key.
# Production on Cloud Run should prefer Vertex AI with ADC + Secret Manager.
GEMINI_API_KEY="test_gemini_api_key"
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT="test-project-id"
GOOGLE_CLOUD_LOCATION="global"

# --- Firebase Security / Database ---
FIREBASE_PROJECT_ID="test-project-id"
FIREBASE_DATABASE_ID="(default)"
FIREBASE_CLIENT_EMAIL="firebase-admin@test-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
VITE_FIREBASE_API_KEY="test_api_key"
VITE_FIREBASE_AUTH_DOMAIN="test-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="test-project-id"
VITE_FIREBASE_STORAGE_BUCKET="test-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="(default)"

# --- Vector / Cache ---
DATABASE_URL="postgres://user:pass@localhost:5432/lexguard"
REDIS_URL="redis://localhost:6379"
QDRANT_URL="http://localhost:6333"
